YOLO_MODEL=yoloe-11s-seg.pt
YOLO_DEVICE=auto
YOLO_IMGSZ=640
YOLO_CONF=0.25
YOLO_IOU=0.7

# Open-vocabulary prompts (comma-separated). Used by YOLOE / YOLO-World only.
# YOLOE-seg detects NOTHING until this is set. Ignored by closed-vocab models
# such as yolo11s-seg.pt. Edit freely to whatever you want to detect.
YOLO_CLASSES=person,orange,plate,cup,bottle,bowl,banana,apple,box,scissors

# Single camera fallback
CAMERA_ID=front_rgb
CAMERA_INDEX=0

# Multi-camera (preferred when using more than one camera)
# Format: camera_id:index,camera_id:index
# Example: CAMERAS=front_rgb:0,side_rgb:1,top_rgb:2
CAMERAS=

# Capture thread FPS — raw frames + ZMQ outbound rate.
# Match this to the FPS used during LeRobot data collection for train/infer consistency.
CAMERA_CAPTURE_FPS=30

# Perception thread FPS — YOLO inference rate cap. Runs independently of capture,
# so slowdowns here never throttle ZMQ raw-frame streaming.
CAMERA_TARGET_FPS=10

CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
SCENE_JSON_PATH=runtime/latest_scene_{camera_id}.json
SCENE_LOG_DIR=runtime/logs

# ─── ZMQ raw-frame publisher (for LeRobot integration) ───────────────────────
# When enabled, PAI-Vision becomes the single camera owner and broadcasts raw
# frames over a ZMQ PUB socket using the same wire format as LeRobot's
# image_server.py. LeRobot's ZMQCamera consumes the stream unchanged:
#
#   --robot.cameras="{front_rgb: {type: zmq, server_address: localhost,
#                                  port: 5555, camera_name: front_rgb,
#                                  width: 1280, height: 720, fps: 30}}"
#
# camera_name on LeRobot side MUST match CAMERA_ID here.
ZMQ_PUBLISH_ENABLED=false
ZMQ_PUBLISH_BIND=tcp://*:5555
ZMQ_PUBLISH_FPS=30
ZMQ_PUBLISH_JPEG_QUALITY=90

# ─── Foreground cutout stream (background removed, objects only) ──────────────
# Builds a per-frame RGBA cutout from the detected-object masks (background made
# transparent) and streams it. WebSocket is always on when CUTOUT_ENABLED:
#   ws://localhost:8000/ws/cutouts?camera_id=front_rgb     (base64 image frames)
#   http://localhost:8000/cutout/viewer                    (browser preview)
#   http://localhost:8000/cutout/latest?camera_id=front_rgb (decoded image)
# ZMQ is opt-in and binds a SEPARATE port from the raw-frame publisher (:5555).
CUTOUT_ENABLED=true
CUTOUT_FPS=15
CUTOUT_FORMAT=webp        # webp (alpha, small) | png (alpha, lossless)
CUTOUT_QUALITY=80         # webp lossy quality
CUTOUT_ZMQ_ENABLED=false
CUTOUT_ZMQ_BIND=tcp://*:5556
